# PostgreSQL 连接串（必填）。容器启动时自动执行 EF 迁移，
# Data Protection 密钥也会持久化到该数据库。
# 示例：Host=postgres;Port=5432;Database=university_link;Username=university_link;Password=change-me
SQL=

# 必需：JWT 签名密钥。建议 32 字节以上的随机值，例如 openssl rand -base64 48。
JWT_SECRET=

# 必需：XAUAT SSO OAuth 凭据（回调地址为 /Auth/Callback）。
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# 可选：宿主机映射端口，默认 8080。
APP_PORT=8080
